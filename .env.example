# Local development values only. Do not use these credentials outside a local demo.
DB_NAME=authorization
DB_USER=authorization
DB_PASSWORD=local_dev_password
DB_PORT=5432

DB_URL=jdbc:postgresql://127.0.0.1:${DB_PORT:-5432}/${DB_NAME:-authorization}
OAUTH_ISSUER=http://127.0.0.1:9000
SPA_ORIGIN=http://127.0.0.1:9000
SPA_REDIRECT_URI=http://127.0.0.1:9000/
POSTMAN_REDIRECT_URI=https://oauth.pstmn.io/v1/callback
POSTMAN_CLIENT_SECRET=postman-local-secret
CUSTOM_GRANT_CODE=local-demo-code
OAUTH_SIGNING_KEY_DIR=.local-keys
API_AUDIENCE=api://authorization-server
ACCESS_TOKEN_TTL_SECONDS=300
REFRESH_TOKEN_TTL_SECONDS=86400
BOOTSTRAP_USER_ENABLED=true
BOOTSTRAP_USER=demo
BOOTSTRAP_PASSWORD=demo12345
